/* =============================================================
   ADK Homepage — all rules scoped under .adk-landing
   Uses Material CSS variables for automatic light/dark support
   ============================================================= */

/* --- Hide Material chrome on homepage --- */
/* Use :has() for modern browsers + JS fallback adds body.adk-landing-page */
.md-content:has(.adk-landing) { max-width: none !important; margin: 0 !important; }
.md-main__inner:has(.adk-landing) { max-width: none !important; margin: 0 !important; padding: 0 !important; }
.md-content__inner:has(.adk-landing) { max-width: 1280px !important; margin: 0 auto !important; padding: 0 clamp(16px, 4vw, 48px) !important; }
.md-sidebar:has(~ .md-content .adk-landing) { display: none !important; }
.md-footer:has(~ .adk-landing) { display: none; }

/* JS fallback via body class */
body.adk-landing-page .md-sidebar { display: none !important; }
body.adk-landing-page .md-main__inner { max-width: none !important; margin: 0 !important; padding: 0 !important; }
body.adk-landing-page .md-content { max-width: none !important; margin: 0 !important; }
body.adk-landing-page .md-content__inner { max-width: 1280px !important; margin: 0 auto !important; padding: 0 clamp(16px, 4vw, 48px) !important; }
body.adk-landing-page .md-footer { display: none; }

/* --- Landing wrapper variables (adapts to light/dark via Material) --- */
.adk-landing {
  --landing-bg: var(--md-default-bg-color);
  --landing-fg: var(--md-default-fg-color);
  --landing-muted: var(--md-default-fg-color--light);
  --landing-surface: var(--md-code-bg-color);
  --landing-border: var(--md-default-fg-color--lightest);
  --landing-accent: #3b82f6;
  --landing-accent2: #8b5cf6;
  --landing-accent-gradient: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
  --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
  --font-mono: 'JetBrains Mono', 'Roboto Mono', monospace;

  position: relative;
  font-family: var(--font-sans);
  color: var(--landing-fg);
  line-height: 1.6;
  overflow-x: hidden;
}

/* Reset md-typeset interference inside landing */
.md-typeset .adk-landing { font-size: 1rem; line-height: 1.6; color: var(--landing-fg); }
.md-typeset .adk-landing h1,
.md-typeset .adk-landing h2,
.md-typeset .adk-landing h3 {
  color: var(--landing-fg);
  margin-top: 0;
  font-family: var(--font-sans);
  letter-spacing: -0.02em;
}
.md-typeset .adk-landing p { color: var(--landing-muted); }
.md-typeset .adk-landing a { color: inherit; }

/* --- Ambient Glows (subtle, dark mode only) --- */
.adk-landing .glow {
  position: absolute; border-radius: 50%; filter: blur(120px); z-index: 0; pointer-events: none; opacity: 0;
}
[data-md-color-scheme="slate"] .adk-landing .glow { opacity: 0.35; }
.adk-landing .glow-tl { top: -10%; left: -10%; width: 500px; height: 500px; background: rgba(59,130,246,0.25); }
.adk-landing .glow-tr { top: -5%; right: -5%; width: 600px; height: 600px; background: rgba(139,92,246,0.15); }
.adk-landing .glow-mr { top: 40%; right: -10%; width: 400px; height: 400px; background: rgba(59,130,246,0.15); }

/* ========================
   HERO SECTION
   ======================== */
.adk-landing .hero-grid {
  padding: clamp(48px, 8vw, 96px) 0;
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: clamp(32px, 5vw, 64px);
  align-items: center;
  position: relative;
  z-index: 10;
}

.adk-landing .hero-content h1 {
  font-size: clamp(2rem, 5vw, 3.75rem);
  line-height: 1.1;
  font-weight: 800;
  letter-spacing: -0.04em;
  margin-bottom: 20px;
}
/* Gradient text in dark mode, solid in light */
[data-md-color-scheme="slate"] .adk-landing .hero-content h1 {
  background: linear-gradient(to right, #ffffff, #a1a1aa);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.adk-landing .hero-content > p {
  font-size: clamp(1rem, 1.5vw, 1.2rem);
  color: var(--landing-muted);
  margin-bottom: 32px;
  max-width: 540px;
}
.adk-landing .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

/* --- Buttons --- */
.adk-landing .btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 12px 24px; border-radius: 8px;
  font-weight: 600; font-size: 1rem;
  text-decoration: none !important;
  transition: all 0.2s; cursor: pointer;
  border: none;
}
.adk-landing .btn-primary {
  background: var(--landing-accent-gradient); color: #fff !important;
  box-shadow: 0 4px 14px rgba(59,130,246,0.25);
}
.adk-landing .btn-primary:hover {
  box-shadow: 0 6px 20px rgba(59,130,246,0.4); transform: translateY(-1px);
}
.adk-landing .btn-secondary {
  background: var(--landing-surface); color: var(--landing-fg) !important;
  border: 1px solid var(--landing-border);
}
.adk-landing .btn-secondary:hover {
  background: var(--md-code-bg-color); border-color: var(--landing-muted); transform: translateY(-1px);
}

/* --- GitHub link button (inside tab area) --- */
.adk-landing .github-link {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 0.85rem; font-weight: 600;
  color: var(--landing-muted) !important;
  text-decoration: none !important;
  transition: color 0.2s;
}
.adk-landing .github-link:hover { color: var(--landing-fg) !important; }
.adk-landing .github-link svg { width: 18px; height: 18px; fill: currentColor; }

/* ========================
   MAC-STYLE CODE WINDOW
   ======================== */
.adk-landing .mac-window {
  background: var(--landing-surface);
  border: 1px solid var(--landing-border);
  border-radius: 12px; overflow: hidden;
  box-shadow: 0 12px 40px rgba(0,0,0,0.12);
}
[data-md-color-scheme="slate"] .adk-landing .mac-window {
  box-shadow: 0 24px 48px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.05);
}
.adk-landing .window-header {
  background: var(--md-code-bg-color);
  padding: 12px 16px; display: flex; align-items: center;
  border-bottom: 1px solid var(--landing-border);
}
.adk-landing .window-dots { display: flex; gap: 8px; }
.adk-landing .window-dot { width: 12px; height: 12px; border-radius: 50%; }
.adk-landing .window-dot.red { background: #ff5f56; }
.adk-landing .window-dot.yellow { background: #ffbd2e; }
.adk-landing .window-dot.green { background: #27c93f; }
.adk-landing .window-title {
  flex: 1; text-align: center; color: var(--landing-muted);
  font-family: var(--font-mono); font-size: 0.85rem; margin-left: -44px;
}

/* --- iTerm-style tabs --- */
.adk-landing .iterm-tab-bar {
  display: flex; background: var(--md-code-bg-color); padding: 0;
  border-bottom: 1px solid var(--landing-border);
  border-radius: 12px 12px 0 0; overflow: hidden;
}
.adk-landing .iterm-tab {
  padding: 10px 20px; font-family: var(--font-mono); font-size: 0.82rem;
  color: var(--landing-muted); cursor: pointer; transition: all 0.15s;
  border-right: 1px solid var(--landing-border);
  display: flex; align-items: center; gap: 6px; user-select: none;
  position: relative;
}
.adk-landing .iterm-tab:hover { color: var(--landing-fg); }
.adk-landing .iterm-tab.active {
  color: var(--landing-fg);
  border-bottom: 2px solid var(--landing-accent);
}
[data-md-color-scheme="slate"] .adk-landing .iterm-tab.active {
  background: rgba(255,255,255,0.04);
}
[data-md-color-scheme="default"] .adk-landing .iterm-tab.active {
  background: rgba(0,0,0,0.04);
}

/* --- Code content --- */
.adk-landing .code-content {
  padding: 24px; font-family: var(--font-mono); font-size: clamp(0.78rem, 1vw, 0.9rem);
  line-height: 1.6; color: var(--landing-fg); overflow-x: auto;
}
.adk-landing .code-content pre {
  margin: 0; white-space: pre; background: transparent !important;
  color: inherit; font-family: inherit; font-size: inherit; line-height: inherit;
}
.adk-landing .kw { color: #c678dd; }
.adk-landing .str { color: #98c379; }
.adk-landing .fn { color: #61afef; }
[data-md-color-scheme="default"] .adk-landing .kw { color: #a626a4; }
[data-md-color-scheme="default"] .adk-landing .str { color: #50a14f; }
[data-md-color-scheme="default"] .adk-landing .fn { color: #4078f2; }

/* --- Install info bar --- */
.adk-landing .install-info {
  display: flex; align-items: center; gap: 16px; padding: 12px 20px; flex-wrap: wrap;
  background: var(--landing-surface); border: 1px solid var(--landing-border);
  border-radius: 0 0 12px 12px; margin-top: -1px;
}
.adk-landing .install-cmd code {
  background: var(--md-code-bg-color); padding: 6px 12px; border-radius: 6px;
  font-family: var(--font-mono); font-size: 0.85rem; color: var(--landing-fg);
  border: 1px solid var(--landing-border);
}
.adk-landing .install-badges { display: flex; gap: 8px; flex-wrap: wrap; }
.adk-landing .badge {
  display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 12px;
  font-size: 0.75rem; font-weight: 600; font-family: var(--font-mono);
}
.adk-landing .badge-version { background: rgba(59,130,246,0.1); color: #3b82f6; border: 1px solid rgba(59,130,246,0.25); }
.adk-landing .badge-stars { background: rgba(234,179,8,0.08); color: #ca8a04; border: 1px solid rgba(234,179,8,0.2); }
.adk-landing .badge-downloads { background: rgba(16,185,129,0.08); color: #059669; border: 1px solid rgba(16,185,129,0.2); }
[data-md-color-scheme="slate"] .adk-landing .badge-version { color: #60a5fa; }
[data-md-color-scheme="slate"] .adk-landing .badge-stars { color: #fbbf24; }
[data-md-color-scheme="slate"] .adk-landing .badge-downloads { color: #34d399; }

/* ========================
   FEATURE SPLIT SECTIONS
   ======================== */
.adk-landing .feature-split {
  display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(40px, 6vw, 80px);
  align-items: center; padding: clamp(48px, 8vw, 100px) 0;
  position: relative; z-index: 10;
}
.adk-landing .feature-split.reverse { grid-template-columns: 1.2fr 1fr; }
.adk-landing .feature-split.reverse .feature-text { order: 2; }
.adk-landing .feature-split.reverse .feature-visual { order: 1; }

.adk-landing .feature-badge {
  display: inline-block; padding: 6px 14px;
  background: rgba(139,92,246,0.08); color: #7c3aed;
  border-radius: 20px; font-size: 0.875rem; font-weight: 600; margin-bottom: 20px;
  border: 1px solid rgba(139,92,246,0.15);
}
[data-md-color-scheme="slate"] .adk-landing .feature-badge {
  background: rgba(139,92,246,0.1); color: #a78bfa;
  border-color: rgba(139,92,246,0.2);
}
.adk-landing .feature-text h2 {
  font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 700;
  letter-spacing: -0.03em; margin-bottom: 20px;
}
.adk-landing .feature-text p {
  font-size: clamp(0.95rem, 1.2vw, 1.1rem); color: var(--landing-muted); margin-bottom: 20px;
}

/* --- Terminal window --- */
.adk-landing .terminal .terminal-body {
  padding: 24px; font-family: var(--font-mono); font-size: 0.85rem;
  line-height: 1.6; height: 340px; overflow-y: auto;
  color: var(--landing-fg);
}
.adk-landing .term-line { margin-bottom: 8px; }
.adk-landing .term-prompt { color: #10b981; margin-right: 8px; }
.adk-landing .term-cmd { color: var(--landing-fg); }
.adk-landing .term-spinner { color: var(--landing-accent); display: inline-block; animation: adkSpin 1s linear infinite; margin-right: 8px; }
.adk-landing .term-system { color: var(--landing-muted); }
.adk-landing .term-success { color: #10b981; }
.adk-landing .term-code-block {
  background: var(--md-code-bg-color); padding: 16px; border-radius: 6px;
  margin: 12px 0; border: 1px solid var(--landing-border);
}
.adk-landing .term-code-block pre { margin: 0; }
.adk-landing .term-code-block code { font-size: 0.82rem; color: var(--landing-fg); }
@keyframes adkSpin { 100% { transform: rotate(360deg); } }

/* --- Dev UI image --- */
.adk-landing .ui-wrapper {
  position: relative; border-radius: 12px; padding: 8px;
  background: var(--landing-surface);
  border: 1px solid var(--landing-border);
}
.adk-landing .devui-img {
  max-width: 100%; max-height: 500px; object-fit: contain; border-radius: 8px;
  display: block; margin: 0 auto;
}

/* ========================
   EVAL SECTION
   ======================== */
.adk-landing .eval-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
.adk-landing .eval-card {
  background: var(--landing-surface); border: 1px solid var(--landing-border);
  border-radius: 8px; padding: 14px;
}
.adk-landing .eval-card.pass { border-left: 3px solid #10b981; }
.adk-landing .eval-card.fail { border-left: 3px solid #ef4444; }
.adk-landing .eval-title {
  font-size: 0.82rem; font-family: var(--font-mono); color: var(--landing-fg);
  display: flex; justify-content: space-between; margin-bottom: 6px;
}
.adk-landing .eval-status.pass { color: #10b981; }
.adk-landing .eval-status.fail { color: #ef4444; }
.adk-landing .eval-desc { font-size: 0.82rem; color: var(--landing-muted); }

/* --- Metrics Dashboard --- */
.adk-landing .metrics-dashboard {
  display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px;
  background: var(--landing-surface); border: 1px solid var(--landing-border);
  border-radius: 12px; padding: 24px;
}
.adk-landing .metrics-chart-label {
  font-size: 0.82rem; font-weight: 600; color: var(--landing-muted); margin-bottom: 12px;
}
.adk-landing .metrics-svg { width: 100%; height: auto; }
.adk-landing .metrics-svg line { stroke: var(--landing-border); }
.adk-landing .metrics-svg text { fill: var(--landing-muted); }
.adk-landing .metrics-table {
  width: 100%; border-collapse: collapse; font-size: 0.8rem; font-family: var(--font-mono);
}
.adk-landing .metrics-table th {
  text-align: left; padding: 8px 10px; color: var(--landing-muted);
  border-bottom: 1px solid var(--landing-border); font-weight: 600;
}
.adk-landing .metrics-table td {
  padding: 8px 10px; border-bottom: 1px solid var(--landing-border); color: var(--landing-fg);
}
.adk-landing .delta-green { color: #10b981; font-weight: 600; }
.adk-landing .delta-red { color: #ef4444; font-weight: 600; }
.adk-landing .delta-neutral { color: var(--landing-muted); }
.adk-landing .metric-green td:first-child { border-left: 3px solid #10b981; }
.adk-landing .metric-red td:first-child { border-left: 3px solid #ef4444; }
.adk-landing .metric-neutral td:first-child { border-left: 3px solid var(--landing-border); }

/* ========================
   LOW FLOOR HIGH CEILING
   ======================== */
.adk-landing .ceiling-section {
  padding: clamp(48px, 8vw, 100px) 0;
  position: relative; z-index: 10;
  text-align: center;
}
.adk-landing .ceiling-section h2 {
  font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 800;
  letter-spacing: -0.03em; margin-bottom: 8px;
}
.adk-landing .ceiling-section .section-subtitle {
  color: var(--landing-muted); font-size: clamp(1rem, 1.3vw, 1.15rem);
  max-width: 600px; margin: 0 auto 40px;
}

.adk-landing .carousel-track {
  display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory;
  padding: 8px 4px 24px;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: thin;
  scrollbar-color: var(--landing-border) transparent;
}
.adk-landing .carousel-track::-webkit-scrollbar { height: 6px; }
.adk-landing .carousel-track::-webkit-scrollbar-track { background: transparent; }
.adk-landing .carousel-track::-webkit-scrollbar-thumb { background: var(--landing-border); border-radius: 3px; }

.adk-landing .carousel-card {
  flex: 0 0 300px; scroll-snap-align: start;
  background: var(--landing-surface);
  border: 1px solid var(--landing-border);
  border-radius: 12px; padding: 28px 24px;
  text-align: left; transition: transform 0.2s, box-shadow 0.2s;
}
.adk-landing .carousel-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(0,0,0,0.1);
}
[data-md-color-scheme="slate"] .adk-landing .carousel-card:hover {
  box-shadow: 0 8px 24px rgba(0,0,0,0.3);
}
.adk-landing .carousel-card .card-icon {
  font-size: 2rem; margin-bottom: 12px; display: block;
}
.adk-landing .carousel-card h3 {
  font-size: 1.05rem; font-weight: 700; margin-bottom: 8px; color: var(--landing-fg);
}
.adk-landing .carousel-card p {
  font-size: 0.9rem; color: var(--landing-muted); line-height: 1.5; margin: 0;
}

/* ========================
   RESPONSIVE
   ======================== */
@media (max-width: 1200px) {
  .adk-landing .hero-grid {
    grid-template-columns: 1fr; text-align: center; gap: 40px;
  }
  .adk-landing .hero-content > p { margin-left: auto; margin-right: auto; }
  .adk-landing .hero-actions { justify-content: center; }
  .adk-landing .feature-split,
  .adk-landing .feature-split.reverse {
    grid-template-columns: 1fr; gap: 32px;
  }
  .adk-landing .feature-split.reverse .feature-text { order: 1; }
  .adk-landing .feature-split.reverse .feature-visual { order: 2; }
  .adk-landing .metrics-dashboard { grid-template-columns: 1fr; }
}

@media (max-width: 768px) {
  .adk-landing .eval-grid { grid-template-columns: 1fr; }
  .adk-landing .iterm-tab { padding: 8px 12px; font-size: 0.75rem; }
  .adk-landing .install-info { flex-direction: column; align-items: flex-start; gap: 8px; }
  .adk-landing .carousel-card { flex: 0 0 260px; }
}

@media (max-width: 480px) {
  .adk-landing .iterm-tab span { display: none; }
  .adk-landing .carousel-card { flex: 0 0 85vw; }
}

/* --- Add homepage body class via CSS page identifier --- */
/* Material adds data-md-component to body; we use the hide metadata to detect homepage */
