[16.484292, "o", "\u001b[?1l\u001b>\u001b[?2004l\r\r\n\u001b]2;uvx agent-starter-pack create --adk my-agent\u0007\u001b]1;uvx\u0007\u001b[37m\u280b\u001b[0m \u001b[2mResolving dependencies...                                                          \u001b[0m\r\u001b[2K\u001b[37m\u2819\u001b[0m \u001b[2mResolving dependencies...                                                          \u001b[0m\r\u001b[2K\u001b[37m\u280b\u001b[0m \u001b[2mResolving dependencies...                                                          \u001b[0m\r\u001b[2K\u001b[37m\u2819\u001b[0m \u001b[2mResolving dependencies...                                                          \u001b[0m\r\u001b[2K\u001b[37m\u2819\u001b[0m \u001b[2magent-starter-pack==0.38.0                                                         \u001b[0m\r\u001b[2K\u001b[37m\u2819\u001b[0m \u001b[2mbackoff==2.2.1                                                                     \u001b[0m\r\u001b[2K\u001b[37m\u2819\u001b[0m \u001b[2mclick==8.3.1                                                                       \u001b[0m\r\u001b[2K\u001b[37m\u2819\u001b[0m \u001b[2mcookiecutter==2.7.1                                                                \u001b[0m\r\u001b[2K\u001b[37m\u2819\u001b[0m \u001b[2mgoogle-cloud-aiplatform==1.140.0                                                   \u001b[0m"]
